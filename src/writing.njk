---
layout: base.njk
title: Writing
description: "Posts from the digital garden, with native posts published occasionally on this site."
permalink: /writing/
---
<h1>Writing</h1>

<p class="lede">Writing originates in the garden at <a href="https://cognitivearchitecture.ca/">cognitivearchitecture.ca</a>. Native posts here are rare &mdash; this page is a hub, not a destination.</p>

{%- set syndicatedUrls = [] %}
{%- for post in collections.writing %}
  {%- if post.data.syndicated and post.data.gardenUrl %}
    {%- set syndicatedUrls = (syndicatedUrls.push(post.data.gardenUrl), syndicatedUrls) %}
  {%- endif %}
{%- endfor %}

<section class="h-feed" aria-labelledby="writing-feed-heading">
  <span class="p-name sr-only" id="writing-feed-heading">Writing</span>

  {%- if gardenPosts.length %}
  <h2>From the Garden</h2>
  <section class="index-table garden-panel" aria-label="From the Garden">
    {%- set gardenShown = 0 %}
    {%- for gp in gardenPosts %}
      {%- if gp.url not in syndicatedUrls and gardenShown < 12 %}
        {%- set gardenShown = gardenShown + 1 %}
    <article class="index-row h-entry">
      <span class="index-row__label">garden/</span>
      <span class="index-row__desc">
        <a class="u-url p-name" href="{{ gp.url }}" rel="external">{{ gp.title }}</a>
        {%- if gp.status %} <span class="index-pill">{{ gp.status }}</span>{%- endif %}
      </span>
      {%- if gp.date %}
      <time class="index-row__meta dt-published" datetime="{{ gp.date }}">{{ gp.date | shortDate }}</time>
      {%- else %}
      <span class="index-row__meta"></span>
      {%- endif %}
    </article>
      {%- endif %}
    {%- endfor %}
    <div class="index-row">
      <span class="index-row__label">garden/</span>
      <span class="index-row__desc">
        <a href="https://cognitivearchitecture.ca/" rel="external">more in the garden &rarr;</a>
      </span>
      <span class="index-row__meta">{{ "https://cognitivearchitecture.ca/" | hostname }} &#8599;</span>
    </div>
  </section>
  {%- else %}
  <p>Garden offline at build time. See <a href="https://cognitivearchitecture.ca/">the source</a>.</p>
  {%- endif %}

  {%- if collections.writing.length %}
  <h2>Also published natively here</h2>
  <ul class="native-posts">
    {%- for post in collections.writing %}
    <li class="h-entry">
      <a class="u-url p-name" href="{{ post.url }}">{{ post.data.title }}</a>
      <time class="dt-published" datetime="{{ post.date | isoDate }}"> &middot; {{ post.date | isoDateShort }}</time>
    </li>
    {%- endfor %}
  </ul>
  {%- endif %}
</section>

{%- if collections.tagList and collections.tagList.length %}
<p class="tag-browse">
  Browse by tag:
  {%- for tag in collections.tagList %}
  {% if loop.index0 > 0 %}&middot;{% endif %}
  <a href="/writing/tags/{{ tag | slug }}/">{{ tag }}</a>
  {%- endfor %}
</p>
{%- endif %}
