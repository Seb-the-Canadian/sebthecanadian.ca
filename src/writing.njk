---
layout: base.njk
title: Writing
description: "Posts published natively on this site."
permalink: /writing/
noindex: true
---
{% set mastheadLabel = "writing/" %}
{% set mastheadLede %}Posts published natively on this site.{% endset %}
{% include "masthead.njk" %}

<section class="h-feed" aria-labelledby="writing-feed-heading">
  <span class="p-name sr-only" id="writing-feed-heading">Writing</span>

  {%- if collections.writing.length %}
  <h2 class="eyebrow">Published here</h2>
  <ul class="native-posts">
    {%- for post in collections.writing %}
    <li class="h-entry">
      <a class="u-url p-name" href="{{ post.url }}">{{ post.data.title }}</a>
      <time class="dt-published" datetime="{{ post.date | isoDate }}"> &middot; {{ post.date | humanDate }}</time>
    </li>
    {%- endfor %}
  </ul>
  {%- endif %}
</section>

{%- if collections.tagList and collections.tagList.length %}
<p class="tag-browse">
  Browse by tag:
  {%- for tag in collections.tagList %}
  {% if loop.index0 > 0 %}&middot;{% endif %}
  <a href="/writing/tags/{{ tag | slug }}/">{{ tag }}</a>
  {%- endfor %}
</p>
{%- endif %}
