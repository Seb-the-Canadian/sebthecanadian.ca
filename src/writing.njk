---
layout: base.njk
title: Writing
description: "Notes and longer pieces, written and tended on this site."
permalink: /writing/
---
{% set mastheadLabel = "writing/" %}
{% set mastheadLede %}Notes and longer pieces, written and tended here. Notes are short and often unfinished, so each one says how far along it is.{% endset %}
{% include "masthead.njk" %}

<section class="h-feed" aria-labelledby="writing-feed-heading">
  <span class="p-name sr-only" id="writing-feed-heading">Writing</span>

  {%- if collections.writing.length %}
  <div class="index-table">
    {%- for post in collections.writing %}
    {%- include "writing-row.njk" %}
    {%- endfor %}
  </div>
  {%- endif %}
</section>

<p class="writing-key">
  <span class="eyebrow">How far along</span>
  <span><strong>seedling</strong> a first pass &middot; <strong>budding</strong> reworked &middot; <strong>evergreen</strong> settled</span>
</p>

{%- if collections.tagList and collections.tagList.length %}
<p class="tag-browse">
  Browse by tag:
  {%- for tag in collections.tagList %}
  {% if loop.index0 > 0 %}&middot;{% endif %}
  <a href="/writing/tags/{{ tag | slug }}/">{{ tag }}</a>
  {%- endfor %}
</p>
{%- endif %}
