---
layout: base.njk
title: Seb (the Canadian)
description: "Personal site for Seb Lathangue — civic technology, knowledge architecture, and the digital garden."
---
<div class="h-card">
  <p class="identity">
    <span class="masthead__stamp" aria-hidden="true">S&middot;L</span>
    <strong class="p-name">Seb Lathangue</strong>
    <span class="identity__sep">—</span>
    <span class="p-category">civic tech</span>
    <span class="identity__sep">·</span>
    <span class="p-category">knowledge architecture</span>
    <span class="identity__sep">·</span>
    <span class="p-locality">Toronto</span><span class="identity__sep">/</span><span class="p-region">ON</span>
    <a class="u-url u-uid sr-only" href="{{ site.url }}">{{ site.url }}</a>
    <span class="p-country-name sr-only">Canada</span>
  </p>

  <section id="now" class="home-now panel--alt frame">
    {% include "corners.njk" %}
    <h2 class="section-tag is-first"><span class="num">01</span> Now</h2>
    <p>
      <strong>Currently:</strong> {{ now.currently | safe }}
    </p>
    <p class="post-meta">
      <span class="live-dot" aria-hidden="true"></span><time class="dt-updated" datetime="{{ now.updated }}">{{ now.updated | tendedState }}</time>
    </p>
  </section>

  <hr class="pixel-divider" />

  <section aria-label="Writing">
    <h2 class="section-tag"><span class="num">02</span> Writing</h2>
    <div class="index-table">
      {%- set latestPost = collections.writing | first %}
      {%- if latestPost %}
      <article class="index-row h-entry">
        <span class="index-row__label">writing/</span>
        <span class="index-row__desc">
          <a class="u-url p-name" href="{{ latestPost.url }}">{{ latestPost.data.title }}</a>
        </span>
        <time class="index-row__meta dt-published" datetime="{{ latestPost.date | isoDate }}">{{ latestPost.date | shortDate }}</time>
      </article>
      {%- endif %}
    </div>

    {%- if gardenPosts.length > 0 %}
    {#- The garden gets its own weather: a scoped forest-at-night block
        (design-v3 Phase 2, D1), now with the field-notebook corner frame. -#}
    <div class="index-table garden-panel panel--night frame" role="group" aria-label="From the garden">
      {% include "corners.njk" %}
      {%- for gp in gardenPosts %}{% if loop.index <= 4 %}
      <article class="index-row h-entry">
        <span class="index-row__label">garden/</span>
        <span class="index-row__desc">
          <a class="u-url p-name" href="{{ gp.url }}">{{ gp.title }}</a>
          {%- if gp.status %} <span class="index-pill">{{ gp.status }}</span>{%- endif %}
        </span>
        <time class="index-row__meta dt-published" datetime="{{ gp.date }}">{{ gp.date | shortDate }}</time>
      </article>
      {% endif %}{%- endfor %}
      <div class="index-row">
        <span class="index-row__label">garden/</span>
        <span class="index-row__desc">
          <a href="https://cognitivearchitecture.ca/">more in the garden &rarr;</a>
        </span>
        <span class="index-row__meta">{{ "https://cognitivearchitecture.ca/" | hostname }} &#8599;</span>
      </div>
    </div>
    {%- endif %}
  </section>

  <hr class="pixel-divider" />

  <section aria-label="Building">
    <h2 class="section-tag"><span class="num">03</span> Building</h2>
    <div class="index-table">
      {%- for project in projects %}
        {%- if project.status == "active" and project.name != "Cognitive Architecture" and "cognitivearchitecture.ca" not in project.url %}
      <div class="index-row">
        <span class="index-row__label">project/</span>
        <span class="index-row__desc">
          <a href="{{ project.url }}">{{ project.name }}</a>
          <span class="index-pill index-pill--active">active</span>
        </span>
        <span class="index-row__meta">{{ project.url | hostname }} &#8599;</span>
      </div>
        {%- endif %}
      {%- endfor %}
    </div>
  </section>

  <hr class="pixel-divider" />

  <section aria-label="Contact">
    <h2 class="section-tag"><span class="num">04</span> Contact</h2>
    <div class="index-table">
      <div class="index-row">
        <span class="index-row__label">contact/</span>
        <span class="index-row__desc">
          <a class="u-email" href="mailto:{{ site.email }}">{{ site.email }}</a>
          {%- for profile in profiles %} &middot; <a rel="me" href="{{ profile.url }}">{{ profile.platform | lower }}</a>{%- endfor %}
        </span>
        <span class="index-row__meta">end of front door</span>
      </div>
    </div>
  </section>
</div>
