---
layout: base.njk
title: Seb (the Canadian)
description: "Personal site for Seb Lathangue — civic technology, knowledge architecture, and the digital garden."
---
<div class="h-card">
  <section class="hero">
    <img class="u-photo" src="/assets/img/seb-stamp.jpeg" alt="Illustrated portrait of Seb (the Canadian)" />
    <h1 class="p-name">Seb (the Canadian)</h1>
    <p class="tagline">Civic Technology &middot; Knowledge Architecture</p>
    <p class="p-note">I build software for civic participation and think about how knowledge systems shape the way we work together. This is my front door &mdash; a place to find my projects, writing, and how to reach me.</p>
    <a class="u-url u-uid sr-only" href="{{ site.url }}">{{ site.url }}</a>
  </section>

  {% include "garden-section.njk" %}

  <section class="section">
    <h2>Featured Project</h2>
    {%- for project in projects %}
      {%- if project.featured %}
        {% include "project-card.njk" %}
      {%- endif %}
    {%- endfor %}
  </section>

  {%- set latestPost = collections.writing | first %}
  {%- if latestPost %}
  <section class="section">
    <h2>Latest Writing</h2>
    {%- set post = latestPost %}
    {% include "post-card.njk" %}
  </section>
  {%- endif %}

  <section class="section">
    <h2>Profiles</h2>
    <ul class="profile-links">
      {%- for profile in profiles %}
      <li><a rel="me" href="{{ profile.url }}">{{ profile.platform }}</a></li>
      {%- endfor %}
      <li><a class="u-email" href="mailto:{{ site.email }}">{{ site.email }}</a></li>
    </ul>
  </section>
</div>
