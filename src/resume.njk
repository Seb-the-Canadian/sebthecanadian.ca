---
layout: base.njk
title: Résumé
description: "Résumé for Seb Lathangue — data governance, information architecture."
permalink: /resume/
---
<article class="h-resume h-card">
  {%- set mastheadLabel = "résumé/" %}{% set mastheadBare = true %}{% include "masthead.njk" %}
  <header class="resume-header">
    <figure class="resume-photo">
      <picture>
        <source type="image/webp" srcset="/assets/img/seb-headshot.webp" />
        <img class="u-photo" src="/assets/img/seb-headshot.jpg" width="1086" height="724" fetchpriority="high" alt="Photograph of Seb Lathangue" />
      </picture>
    </figure>
    <div class="resume-identity">
      <h1 class="p-name">{{ resume.name }}</h1>
      <p class="tagline">{{ resume.tagline }}</p>
      <p class="resume-contact">
        <a class="u-email" href="mailto:{{ resume.email }}">{{ resume.email }}</a>
        &middot; <span class="p-locality">Toronto</span>, <span class="p-region">Ontario</span>, <span class="p-country-name">Canada</span>
        &middot; <a class="u-url" href="{{ resume.website }}">{{ resume.website }}</a>
      </p>
      <p class="resume-profiles">
        {%- for profile in resume.profiles %}
        <a href="{{ profile.url }}" rel="me">{{ profile.platform }}</a>{% if not loop.last %} &middot; {% endif %}
        {%- endfor %}
      </p>
    </div>
  </header>

  <p class="resume-nav no-print">
    <a href="/about/">&larr; Back to About</a>
    <button class="button button--print" type="button" hidden>Print or save as PDF</button>
  </p>

  {% include "resume-body.njk" %}
</article>
<script src="/assets/js/print.js" defer></script>
