---
layout: base.njk
title: Resume
description: "Resume for Seb Lathangue — civic technology, knowledge architecture."
permalink: /resume/
---
<article class="h-resume h-card">
  <header class="resume-header">
    <figure class="resume-portrait">
      <img class="u-photo" src="/assets/img/seb-stamp-pixel.png" alt="Pixel-art portrait of Seb Lathangue" />
    </figure>
    <div class="resume-identity">
      <h1 class="p-name">{{ resume.name }}</h1>
      <p class="tagline">{{ resume.tagline }}</p>
      <p class="resume-contact">
        <a class="u-email" href="mailto:{{ resume.email }}">{{ resume.email }}</a>
        &middot; <span class="p-locality">Toronto</span>, <span class="p-region">Ontario</span>, <span class="p-country-name">Canada</span>
        &middot; <a class="u-url" href="{{ resume.website }}">{{ resume.website }}</a>
      </p>
      <p class="resume-profiles">
        {%- for profile in resume.profiles %}
        <a href="{{ profile.url }}" rel="me">{{ profile.platform }}</a>{% if not loop.last %} &middot; {% endif %}
        {%- endfor %}
      </p>
    </div>
  </header>

  <button class="theme-toggle no-print" onclick="window.print()">Download PDF</button>

  {%- if resume.summary %}
  <section class="resume-section">
    <h2>Summary</h2>
    <div class="resume-about p-summary">
      {%- for para in resume.summary | paragraphs %}
      <p>{{ para | trim }}</p>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  <section class="resume-section">
    <h2>Experience</h2>
    {%- for role in resume.experience %}
    <div class="resume-entry p-experience h-event">
      <h3 class="p-name">{{ role.title }}</h3>
      <p class="org p-location">
        {%- if role.url %}<a href="{{ role.url }}">{{ role.organization }}</a>{% else %}{{ role.organization }}{% endif %}
        <span class="dates">
          &middot;
          <time class="dt-start" datetime="{{ role.start }}">{{ role.start }}</time>&ndash;{% if role.end %}<time class="dt-end" datetime="{{ role.end }}">{{ role.end }}</time>{% else %}<span>Present</span>{% endif %}
        </span>
      </p>
      <div class="p-summary">
        {%- for para in role.description | paragraphs %}
        <p>{{ para | trim }}</p>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </section>

  {%- if resume.skills %}
  <section class="resume-section">
    <h2>Skills</h2>
    <div class="resume-about">
      {%- for group in resume.skills %}
      <p><strong>{{ group.category }}:</strong> <span class="p-skill">{{ group.items | join(" · ") }}</span></p>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if resume.credentials %}
  <section class="resume-section">
    <h2>Credentials</h2>
    <div class="resume-about p-note">
      {%- for para in resume.credentials | paragraphs %}
      <p>{{ para | trim }}</p>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  <section class="resume-section">
    <h2>Education</h2>
    {%- for edu in resume.education %}
    <div class="resume-entry p-education h-event">
      <h3 class="p-name">{{ edu.credential }}</h3>
      <p class="org">
        {{ edu.institution }}{%- if edu.notes %} <span class="dates">&middot; {{ edu.notes }}</span>{%- endif %}
      </p>
    </div>
    {%- endfor %}
  </section>
</article>
