<script src="/assets/js/case-study.js"></script>
<script>
(function(){
  // Fictional schedule: the first session is full, so the flow routes to the next open one.
  // At step 2 of chapter 1 that session moves (a fictional change) and the flow re-routes.
  const SCHED=[{t:"Tuesday, 10:00",full:true},{t:"Wednesday, 14:00"},{t:"Thursday, 11:00"}];
  const SLOT=SCHED.find(x=>!x.full).t, MOVED="Thursday, 11:00";
  const EXAMPLE="Sam";
  let me=null;                      // {name} once the reader registers; nothing is stored
  const seen=new Set();             // which parts of the confirmation the reader has traced

  // ---- Chapter 1: the trace, the confirmation and the reveal, per figure (sticky or phone copy) ----
  function stepOf(root){return +(root.dataset.n||0);}
  function confParts(n){
    const name=me?me.name:EXAMPLE;
    return {name, slot:n>=2?MOVED:SLOT, old:n>=2?SLOT:null};
  }
  function renderRoot(root){
    const n=stepOf(root), c=confParts(n);
    const af=document.activeElement, refocus=(af&&root.contains(af)&&af.classList.contains("w"))?af.dataset.src:null;
    const nm=me&&me.name;
    const b=me?{
      head:"Your registration, step by step",
      t1:nm?"As "+nm:"Name left blank",
      t2:nm?"Response from "+nm:"Response received",
      t3:n>=2?SLOT+" moved · fictional":"Tuesday is full; "+SLOT+" is open",
      t4:n>=2?"Re-routed to "+MOVED:"Routed to "+SLOT,
      t5:n>=2?"Updated confirmation sent":"Confirmation sent",
      t6:"That was yours."
    }:{head:"A registration, step by step",t1:"",t2:"",t3:"",t4:"",t5:"",t6:""};
    b.conflab=(me?(n>=2?"Your updated confirmation":"Your confirmation"):"An example confirmation")+" · tap a part to see where it came from";
    b.reveal=me?(nm?nm+", you just did what Brindle Lake staff did: used it first, then saw inside.":"You just did what Brindle Lake staff did: used it first, then saw inside."):"Staff used it first, then saw inside.";
    root.querySelectorAll("[data-bind]").forEach(el=>{if(el.dataset.bind in b) el.textContent=b[el.dataset.bind];});
    const msg=root.querySelector("[data-conf]");
    root.querySelectorAll(".stage.src-on").forEach(e=>e.classList.remove("src-on"));
    const why0=root.querySelector(".conf-why"); if(why0) why0.textContent="";
    if(msg){
      msg.textContent="";
      const w=(src,text)=>{const x=document.createElement("button");x.type="button";x.className="w";x.dataset.src=src;x.textContent=text;return x;};
      const t=s=>document.createTextNode(s);
      if(me&&!me.name){msg.append(w("greet","Thanks"),t("! You're booked into "));}
      else {msg.append(w("greet","Thanks"),t(", "),w("name",c.name),t(". You're booked into "));}
      if(c.old){const o=document.createElement("s");o.textContent=c.old;msg.append(o,t(" "));}
      const nw=document.createElement("span");nw.className="nowrap";nw.append(w("slot",c.slot),t("."));msg.append(nw);
    }
    if(refocus){const nb=root.querySelector('.w[data-src="'+refocus+'"]');if(nb)nb.focus({preventScroll:true});}
    renderProg(root);
  }
  function renderProg(root){
    const pr=root.querySelector("[data-prog]"); if(!pr) return;
    const total=(me&&!me.name)?2:3, k=[...seen].filter(x=>total===3||x!=="name").length;
    pr.textContent=k>=total?"✓ all "+total+" traced":k+" of "+total+" traced";pr.classList.toggle("done",k>=total);
  }
  function renderAll(){document.querySelectorAll("#show .graphic, #show .m-fig > *").forEach(renderRoot);}
  document.addEventListener("pudding:layout",renderAll);
  Pudding.onStep("show",(n,root)=>{
    root.dataset.n=n;
    root.querySelectorAll(".stage[data-row]").forEach(r=>{r.tabIndex=(n===1||n===2)?0:-1;});
    root.querySelectorAll("[data-hl]").forEach(e=>e.classList.toggle("hlon",e.dataset.hl.split(",").indexOf(String(n))>-1));
    // Phones: from the reveal on, the six-row trace has been shown three times already
    if(!root.classList.contains("graphic")&&n>=3){const f=root.querySelector(".flow");if(f)f.remove();}
    renderRoot(root);
  });

  // Where did each word come from? Words light their step; steps light their words.
  const ROWNAME={name:"Take the form response",slot:"Check the calendar, then Route to a session",greet:"Send a personalized confirmation"};
  function trace(root,src,fromRow){
    root.querySelectorAll(".src-on").forEach(e=>e.classList.remove("src-on"));
    root.querySelectorAll('[data-row="'+src+'"],.w[data-src="'+src+'"]').forEach(e=>e.classList.add("src-on"));
    const why=root.querySelector(".conf-why");
    const words=[...root.querySelectorAll('.w[data-src="'+src+'"]')].map(e=>e.textContent).join(", ");
    if(why) why.textContent=fromRow?(words?"This step wrote: “"+words+"”.":"This step wrote nothing you can see here."):"Came from: "+ROWNAME[src]+".";
    seen.add(src);
    root.querySelectorAll('.w[data-src="'+src+'"]').forEach(e=>Pudding.changed(e));
    document.querySelectorAll("#show .graphic, #show .m-fig > *").forEach(renderProg);
  }
  document.addEventListener("click",e=>{
    const w=e.target.closest(".w[data-src]");
    if(w){trace(w.closest(".graphic, .m-fig > *"),w.dataset.src,false);return;}
    const row=e.target.closest(".stage[data-row]");
    if(row){trace(row.closest(".graphic, .m-fig > *"),row.dataset.row,true);return;}
    if(e.target.closest("[data-goto-try]")){const f=document.getElementById("try-form");f.scrollIntoView({behavior:Pudding.reduce?"auto":"smooth",block:"center"});setTimeout(()=>document.getElementById("try-name").focus({preventScroll:true}),Pudding.reduce?0:450);return;}
  });
  document.addEventListener("keydown",e=>{
    const row=e.target.closest&&e.target.closest(".stage[data-row]");
    if(row&&(e.key==="Enter"||e.key===" ")){e.preventDefault();trace(row.closest(".graphic, .m-fig > *"),row.dataset.row,true);}
  });

  // ---- Chapter 1, step 4: the same pattern in other work (illustrative) ----
  const EX=[
    ["a sign-up form","the session calendar","to an open session","a personalized email"],
    ["a leave request","the team calendar","to the manager","a decision back to the person"],
    ["an order form","the budget list","to purchasing","an order number back"],
    ["a booking request","room availability","to a free room","a booking confirmation"]
  ];
  document.addEventListener("click",e=>{
    const b=e.target.closest(".pex button[data-ex]"); if(!b) return;
    const card=b.closest(".pattern"), i=+b.dataset.ex;
    card.querySelectorAll(".pex button").forEach(x=>x.setAttribute("aria-pressed",String(x===b)));
    card.querySelectorAll("[data-slot]").forEach((el,k)=>{
      const go=()=>{el.textContent=EX[i][+el.dataset.slot];Pudding.changed(el.parentElement);};
      if(Pudding.reduce) go(); else setTimeout(go,k*130);
    });
  });

  // ---- Chapter 3: the loop, drawn as a loop ----
  (function(){
    const svg=document.querySelector("#system svg.loop"); if(!svg) return;
    const ns="http://www.w3.org/2000/svg";
    const el=(t,a,txt,p)=>{const e=document.createElementNS(ns,t);for(const k in a)e.setAttribute(k,a[k]);if(txt!=null)e.textContent=txt;(p||svg).appendChild(e);return e;};
    const N=["Activate","Learn","Build","Support","Listen","Adapt"], cx=170, cy=107, rx=128, ry=80;
    const pt=a=>[cx+rx*Math.cos(a),cy+ry*Math.sin(a)];
    const ang=i=>-Math.PI/2+i*2*Math.PI/6;
    for(let i=0;i<6;i++){
      const a0=ang(i), a1=ang(i+1), back=i===5, d=[];
      for(let k=0;k<=16;k++){const a=a0+(a1-a0)*k/16;const [x,y]=pt(a);d.push((k?"L":"M")+x.toFixed(1)+" "+y.toFixed(1));}
      el("path",{d:d.join(" "),class:"seg"+(back?" back":"")});
      const am=(a0+a1)/2, [mx,my]=pt(am), tx=-rx*Math.sin(am), ty=ry*Math.cos(am), rot=Math.atan2(ty,tx)*180/Math.PI;
      el("path",{d:"M-4 -4 L4 0 L-4 4 Z",transform:`translate(${mx.toFixed(1)} ${my.toFixed(1)}) rotate(${rot.toFixed(1)})`,class:"chev"+(back?" back":"")});
    }
    N.forEach((name,i)=>{const [x,y]=pt(ang(i));const g=el("g",{class:"node n"+i});el("rect",{x:x-38,y:y-13,width:76,height:26,rx:13},null,g);el("text",{x,y:y+4.5,"text-anchor":"middle"},name,g);});
    el("text",{x:cx,y:cy-2,"text-anchor":"middle",class:"ctr st0t"},"What people said");
    el("text",{x:cx,y:cy+14,"text-anchor":"middle",class:"ctr st0t"},"fed the next round");
    el("text",{x:cx,y:cy-2,"text-anchor":"middle",class:"ctr st1t"},"First round:");
    el("text",{x:cx,y:cy+14,"text-anchor":"middle",class:"ctr st1t"},"a small first cohort");
  })();
  Pudding.onStep("system",(n,root)=>{const l=root.querySelector("svg.loop");if(l)l.setAttribute("class","loop st"+n);});


  // ---- Hero: the sign-up simulation (runs locally, stores nothing) ----
  const form=document.getElementById("try-form"), btn=document.getElementById("try-go"), input=document.getElementById("try-name"),
        rows=[...document.querySelectorAll("#try-log li")], out=document.getElementById("try-out"),
        fin=document.getElementById("try-final"), status=document.getElementById("try-status");
  let running=false;
  form.addEventListener("submit",e=>{
    e.preventDefault();
    if(running) return; running=true; btn.setAttribute("aria-disabled","true");
    const name=(input.value||"").trim().slice(0,40);
    const RES=[name?" · from "+name:" · received", " · Tuesday is full; "+SLOT+" is open", " · "+SLOT, " · sent"];
    rows.forEach(r=>{r.classList.remove("done");r.querySelector(".tick").textContent="○";r.querySelector(".res").textContent="";});
    out.classList.remove("show","ran"); status.textContent="";
    const tick=k=>{const r=rows[k];r.classList.add("done");r.querySelector(".tick").textContent="✓";r.querySelector(".res").textContent=RES[k];};
    const finish=()=>{
      fin.textContent=name?"Thanks, "+name+". You're booked into "+SLOT+".":"Thanks! You're booked into "+SLOT+".";
      out.classList.add("ran"); void out.offsetWidth; out.classList.add("show");
      me={name}; seen.clear(); document.documentElement.classList.add("registered"); renderAll();
      status.textContent="Registered. Four steps ran: response taken, calendar checked, routed to "+SLOT+", confirmation sent.";
      running=false; btn.removeAttribute("aria-disabled"); btn.textContent="Run it again";
    };
    if(Pudding.reduce){rows.forEach((r,k)=>tick(k));finish();return;}
    rows.forEach((r,k)=>setTimeout(()=>tick(k),120+k*220));
    setTimeout(finish,120+4*220);
  });
  renderAll();
})();
</script>
