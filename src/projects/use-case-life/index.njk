            <span>Low-risk</span><span class="cost"><span class="c-ghost">not declared</span></span>
            <span>Medium-risk</span><span class="cost"><span class="c-full">full review</span></span>
            <span>High-risk</span><span class="cost"><span class="c-full">full review</span></span>
          </div>
