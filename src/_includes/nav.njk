<header class="site-header">
  <a href="/" class="site-mark" aria-label="Home">
    <img src="/assets/img/pixel/monogram.svg" alt="" width="24" height="24" class="site-monogram" />
    Seb
  </a>
  <nav aria-label="Primary">
    <ul>
      {%- for item in navigation.primary %}
      <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
</header>
