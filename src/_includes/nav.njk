<header class="site-header">
  <nav aria-label="Primary">
    <ul>
      {%- for item in navigation.primary %}
      <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
  {# The theme switch, exactly as theme-toggle.js builds it. It ships hidden so its box is
      reserved from first paint (no shift when the script runs); the script removes "hidden".
      Without JavaScript it stays invisible and out of the tab order. #}
  <button type="button" class="theme-toggle" role="switch" hidden><span class="theme-toggle__mark" aria-hidden="true"></span>Dark<span class="sr-only"> theme</span></button>
  <span class="sr-only" role="status" aria-live="polite"></span>
</header>
