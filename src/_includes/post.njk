---
layout: base.njk
---
<article class="h-entry">
  <header class="post-header">
    <h1 class="p-name">{{ title }}</h1>
    <p class="post-meta">
      <time class="dt-published" datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {%- if updated %}
      &middot; <time class="dt-updated" datetime="{{ updated }}">updated {{ updated | readableDate }}</time>
      {%- endif %}
      {%- if tags %}
      &middot;
      {%- for tag in tags %}
      <a class="p-category" href="/writing/tags/{{ tag }}/" rel="tag">#{{ tag }}</a>{% if not loop.last %} {% endif %}
      {%- endfor %}
      {%- endif %}
    </p>
  </header>

  <div class="e-content">
    {{ content | safe }}
  </div>

  {%- if syndicated and gardenUrl %}
  <p class="post-syndication">
    <a class="u-syndication" href="{{ gardenUrl }}" rel="external">Read in the garden &rarr;</a>
    {%- if blueskyUrl %}
    &middot; <a class="u-syndication" href="{{ blueskyUrl }}" rel="external">Bluesky</a>
    {%- endif %}
  </p>
  {%- endif %}

  <footer class="post-footer">
    <p class="post-author">
      By
      <a class="p-author h-card" href="{{ site.url }}" rel="author">
        <span class="p-name">{{ site.author }}</span>
      </a>
    </p>
    <p class="post-permalink">
      <a class="u-url" href="{{ site.url }}{{ page.url }}">Permalink</a>
    </p>
  </footer>
</article>
