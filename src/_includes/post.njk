---
layout: base.njk
ogImage: /assets/img/og-writing.png
---
<article class="h-entry">
  <header class="post-header">
    <h1 class="p-name">{{ title }}</h1>
    <p class="post-meta">
      {%- if type %}<span class="post-type">{{ type }}</span> &middot; {% endif %}
      {%- if stage %}<span class="post-stage">{{ stage }}</span> &middot; {% endif %}
      {%- if inProgress %}<span class="index-pill index-pill--active">in progress</span> &middot; {% endif %}
      <time class="dt-published" datetime="{{ page.date | isoDate }}">{{ page.date | humanDate }}</time>
      {%- if updated %}
      &middot; <time class="dt-updated" datetime="{{ updated }}">updated {{ updated | humanDate }}</time>
      {%- endif %}
      {#- Tags, minus the one that just repeats the type ("note" on a note). -#}
      {%- set tagCount = (tags | length) if tags else 0 %}
      {%- set extraCount = tagCount - (1 if (type and tags and type in tags) else 0) %}
      {%- if extraCount > 0 %}
      &middot;
      {%- for tag in tags %}{% if tag != type %}
      <a class="p-category" href="/writing/tags/{{ tag }}/" rel="tag">#{{ tag }}</a>
      {%- endif %}{% endfor %}
      {%- endif %}
    </p>
  </header>

  <div class="e-content">
    {{ content | safe }}
  </div>

  {%- set canonicalUrl = site.url ~ page.url %}
  {%- set thisMentions = webmentions[canonicalUrl] %}
  {%- if thisMentions and thisMentions.length > 0 %}
  <section class="webmentions">
    <h2 class="webmentions-title">Webmentions</h2>
    <ol class="webmentions-list">
      {%- for m in thisMentions %}
      {#- Sender-chosen addresses become links only when they are plain web
          addresses (scripts/webmentions.js filters them too); no avatar, so
          nothing loads from the sender's server. -#}
      {%- set authorUrl = m.author.url if (m.author and m.author.url and (m.author.url.startsWith("https://") or m.author.url.startsWith("http://"))) else "" %}
      {%- set sourceUrl = m.url if (m.url and (m.url.startsWith("https://") or m.url.startsWith("http://"))) else "" %}
      <li class="webmention h-cite">
        {%- if authorUrl %}
        <a class="u-author h-card" href="{{ authorUrl }}" rel="nofollow ugc">
          <span class="p-name">{{ (m.author.name or authorUrl) | truncate(80, true, "…") }}</span>
        </a>
        {%- else %}
        <span class="u-author h-card"><span class="p-name">{{ ((m.author.name if m.author else "") or "someone") | truncate(80, true, "…") }}</span></span>
        {%- endif %}
        <span class="webmention-type">{{ m.type | replace("-", " ") }}</span>
        {%- if m.published %}
        <time class="dt-published" datetime="{{ m.published }}">{{ m.published | humanDate }}</time>
        {%- endif %}
        {%- if sourceUrl %}
        &middot; <a class="u-url" href="{{ sourceUrl }}" rel="external nofollow ugc">source</a>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}

  {%- if syndicated and gardenUrl %}
  <p class="post-syndication">
    <a class="u-syndication" href="{{ gardenUrl }}" rel="external">Read in the garden &rarr;</a>
    {%- if blueskyUrl %}
    &middot; <a class="u-syndication" href="{{ blueskyUrl }}" rel="external">Bluesky</a>
    {%- endif %}
  </p>
  {%- endif %}

  <footer class="post-footer">
    <p class="post-author">
      By
      <a class="p-author h-card" href="{{ site.url }}" rel="author">
        <span class="p-name">{{ site.author }}</span>
      </a>
    </p>
    <p class="post-permalink">
      <a class="u-url" href="{{ site.url }}{{ page.url }}">Permalink</a>
    </p>
    <p class="post-webmention-prompt">
      <a href="https://webmention.io/sebthecanadian.ca/webmention" rel="webmention">Send a webmention &rarr;</a>
    </p>
    <p class="post-more">
      <a href="/writing/">All writing &rarr;</a> &middot; <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </p>
  </footer>
</article>
