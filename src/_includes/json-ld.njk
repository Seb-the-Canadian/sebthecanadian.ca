{#-
  json-ld.njk — schema.org structured data, one block per page.

  Switch: posts chain post.njk -> base.njk, and page front matter wins the
  data cascade, so base.njk sees layout == "post.njk" for native posts.
  Case studies (layout case-study.njk) get an Article too, using the page's
  own description (the "practice piece" sentence). Everything else is matched
  on exact page.url. Tag pages under /writing/tags/ (layout: base.njk)
  deliberately fall through: no block.

  One Person: the home page, About and the résumé declare it with the @id
  below; the author inside every Article points at the same @id, so they
  read as one entity.

  Escaping: the object is built as a Nunjucks dict and serialized once with
  `dump` (JSON.stringify), so quotes/unicode in titles are handled and keys
  whose value is undefined (dateModified, description, keywords) are dropped
  automatically. `replace("</", "<\\/")` prevents a literal "</script>" in
  any field from terminating the script element. `safe` is required because
  autoescape would otherwise turn the JSON quotes into &quot;.
-#}
{%- set jsonld = false -%}
{%- set personId = site.url + "/#person" -%}
{%- set ldAuthor = {
  "@type": "Person",
  "@id": personId,
  "name": site.author,
  "url": site.url + "/"
} -%}
{%- set ldImage = site.url + (ogImage or "/assets/img/og-default.png") -%}
{%- if layout == "post.njk" -%}
  {%- if tags and tags.length -%}{%- set ldKeywords = tags | join(", ") -%}{%- endif -%}
  {%- if updated -%}{%- set ldModified = updated | isoDate -%}{%- endif -%}
  {%- set jsonld = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "url": site.url + page.url,
    "mainEntityOfPage": site.url + page.url,
    "image": ldImage,
    "datePublished": page.date | isoDate,
    "dateModified": ldModified,
    "description": description or excerpt,
    "keywords": ldKeywords,
    "author": ldAuthor
  } -%}
{%- elif layout == "case-study.njk" -%}
  {%- set jsonld = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "url": site.url + page.url,
    "mainEntityOfPage": site.url + page.url,
    "image": ldImage,
    "description": description,
    "author": ldAuthor
  } -%}
{%- elif page.url == "/" or page.url == "/about/" or page.url == "/resume/" -%}
  {%- set sameAs = [] -%}
  {%- for profile in profiles -%}
    {%- set sameAs = (sameAs.push(profile.url), sameAs) -%}
  {%- endfor -%}
  {%- set jsonld = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    "name": site.author,
    "alternateName": ["Sebastian Lathangue", "Seb the Canadian"],
    "url": site.url + "/",
    "image": site.url + "/assets/img/seb-pixel-portrait-510.webp",
    "jobTitle": resume.experience[0].title,
    "knowsAbout": ["data governance", "information architecture", "taxonomy", "metadata"],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Toronto",
      "addressRegion": "Ontario",
      "addressCountry": "CA"
    },
    "sameAs": sameAs
  } -%}
{%- elif page.url == "/writing/" -%}
  {%- set jsonld = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "url": site.url + page.url,
    "description": description,
    "author": ldAuthor
  } -%}
{%- endif -%}
{%- if jsonld %}
  <script type="application/ld+json">{{ jsonld | dump | replace("</", "<\\/") | safe }}</script>
{%- endif %}
