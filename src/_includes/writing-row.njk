{#- One writing index row. Expects `post` (a collection item). The label is
    the post's type (note, essay…), "post" when it has none. In-progress posts
    carry the same pill as on the home page; otherwise the stage word leads
    the date. Set `rowPlain = true` before the include for a row that repeats
    an entry shown elsewhere on the page (the Writing room's NEWEST rows): it
    drops the microformats classes, so a feed reader counts each piece once.
    Set it back to false after. -#}
    <article class="index-row{% if not rowPlain %} h-entry{% endif %}">
      <span class="index-row__label">{{ post.data.type or "post" }}/</span>
      <span class="index-row__desc">
        <a {% if not rowPlain %}class="u-url p-name" {% endif %}href="{{ post.url }}">{{ post.data.title }}</a>
        {%- if post.data.inProgress %}
        <span class="index-pill index-pill--active">in progress</span>
        {%- endif %}
      </span>
      <span class="index-row__meta">{% if post.data.stage %}{{ post.data.stage }} &middot; {% endif %}<time {% if not rowPlain %}class="dt-published" {% endif %}datetime="{{ post.date | isoDate }}">{{ post.date | humanDate }}</time></span>
    </article>
