        you opened the hood. hello.
        this site is hand-built, slowly tended.
        about: https://sebthecanadian.ca/about/
        write back: hello@cognitivearchitecture.ca
-->
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  {%- set pageTitle = site.title if (not title or title == site.title) else (title + " — " + site.title) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description or excerpt or site.description }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {% include "json-ld.njk" %}

  {#- Open Graph — courtesy metadata for humans sharing links -#}
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ description or excerpt or site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:type" content="{% if page.url.startsWith('/writing/') and page.url != '/writing/' %}article{% else %}website{% endif %}" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/img/og-default.png' }}" />
  <meta property="og:locale" content="en_CA" />
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/img/favicon.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" sizes="180x180" />
  <meta name="theme-color" content="#f5f2eb" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#16171a" media="(prefers-color-scheme: dark)" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ description or excerpt or site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/assets/img/og-default.png' }}" />
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  {%- for profile in profiles %}
  <link rel="me" href="{{ profile.url }}" />
  {%- endfor %}
  <link rel="webmention" href="https://webmention.io/sebthecanadian.ca/webmention" />
  <link rel="pingback" href="https://webmention.io/sebthecanadian.ca/xmlrpc" />
  <link rel="stylesheet" href="/assets/css/tokens.css" />
  <link rel="stylesheet" href="/assets/css/base.css" />
  <link rel="stylesheet" href="/assets/css/components.css" />
  <link rel="stylesheet" href="/assets/css/utilities.css" />
  <link rel="stylesheet" href="/assets/css/print.css" media="print" />
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  {% include "nav.njk" %}
  <main id="content">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  <script src="/assets/js/theme-toggle.js" defer></script>
  <script src="/assets/js/keyboard-nav.js" defer></script>
  <script src="/assets/js/console-hello.js" defer></script>
</body>
</html>
