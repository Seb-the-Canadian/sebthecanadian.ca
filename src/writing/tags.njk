---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
layout: base.njk
noindex: true
eleventyComputed:
  title: "Posts tagged #{{ tag }}"
  description: "Native posts on sebthecanadian.ca tagged #{{ tag }}."
permalink: /writing/tags/{{ tag | slug }}/
---
{% set mastheadLabel = "writing/tags/" %}{% include "masthead.njk" %}

<p><a href="/writing/">&larr; All writing</a></p>

<section class="h-feed">
  <span class="p-name sr-only">Posts tagged #{{ tag }}</span>
  {%- set tagPosts = collections.writing %}
  {%- set anyMatch = false %}
  {%- for post in tagPosts %}
    {%- if tag in (post.data.tags or []) %}
      {%- set anyMatch = true %}
    {%- endif %}
  {%- endfor %}
  {%- if anyMatch %}
  <div class="index-table">
    {%- for post in tagPosts %}
      {%- if tag in (post.data.tags or []) %}
    {%- include "writing-row.njk" %}
      {%- endif %}
    {%- endfor %}
  </div>
  {%- else %}
  <p>No posts under this tag yet.</p>
  {%- endif %}
</section>
